// Sistema de Gestión de Emergencias — esquema de base de datos
// Prisma ORM 7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticación / usuarios del panel de gestión
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  COORDINADOR
  OPERADOR
  CONSULTA
}

enum EstadoCuentaUsuario {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoColaborador {
  RESCATISTA
  VOLUNTARIO
  COORDINADOR_VOLUNTARIOS
  CENTRO_ACOPIO
  ENTIDAD
  PROFESIONAL_SALUD
  PROFESIONAL_VETERINARIA
  PROFESIONAL_INGENIERIA_ARQUITECTURA
  OTRO
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         RolUsuario @default(OPERADOR)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])

  // Perfil de colaborador de campo (rescatistas, voluntarios, entidades, etc.)
  estadoCuenta             EstadoCuentaUsuario @default(APROBADA)
  tipoColaborador          TipoColaborador?
  telefono                 String?
  direccionFisica          String?
  contactoEmergenciaNombre String?
  contactoEmergenciaTelefono String?

  // Lugar de acción: la zona donde está colaborando
  lugarAccionDireccion    String?
  lugarAccionMunicipio    String?
  lugarAccionDepartamento String?
  lugarAccionLat          Float?
  lugarAccionLng          Float?

  // Disponibilidad y experticia (principalmente para rescatistas, voluntarios
  // y profesionales de salud, veterinaria, ingeniería/arquitectura)
  disponibilidadTiempo         String?
  disponibilidadDesplazamiento Boolean?
  zonasDesplazamiento          String?
  experticia                   String?
  comoPuedeAyudar              String?

  aprobadoPorId String?
  aprobadoPor   User?     @relation("UserAprobadoPor", fields: [aprobadoPorId], references: [id])
  aprobados     User[]    @relation("UserAprobadoPor")
  aprobadoEn    DateTime?

  // Ubicación en tiempo real (opcional, activada explícitamente por el usuario)
  compartirUbicacion     Boolean   @default(false)
  ubicacionLat           Float?
  ubicacionLng           Float?
  ubicacionActualizadaEn DateTime?

  incidentsCreated      Incident[]        @relation("IncidentCreatedBy")
  incidentsUpdated      Incident[]        @relation("IncidentUpdatedBy")
  personsCreated        Person[]          @relation("PersonCreatedBy")
  transfersCreated      Transfer[]        @relation("TransferCreatedBy")
  aidRequestsCreated    AidRequest[]      @relation("AidRequestCreatedBy")
  aidRequestsUpdated    AidRequest[]      @relation("AidRequestUpdatedBy")
  donationPointsCreated DonationPoint[]   @relation("DonationPointCreatedBy")
  enviosCreados         Envio[]           @relation("EnvioCreatedBy")
  solicitudesCreadas    SolicitudInsumo[] @relation("SolicitudInsumoCreatedBy")
  donationsCreated      Donation[]        @relation("DonationCreatedBy")
  donationsUpdated      Donation[]        @relation("DonationUpdatedBy")
  petsCreated           Pet[]             @relation("PetCreatedBy")
  petsUpdated           Pet[]             @relation("PetUpdatedBy")
  apiKeysCreados        ApiKey[]          @relation("ApiKeyCreatedBy")
  registrosBitacora     RegistroBitacora[] @relation("RegistroBitacoraAutor")
  registrosAtendidos    RegistroBitacora[] @relation("RegistroBitacoraAtendidaPor")
  auditLogs             AuditLog[]

  equipoComoCoordinador SeguimientoEquipo[] @relation("SeguimientoCoordinador")
  equipoComoVoluntario  SeguimientoEquipo[] @relation("SeguimientoVoluntario")

  alertasSOS          AlertaSOS[] @relation("AlertaSOSAutor")
  alertasSOSAtendidas AlertaSOS[] @relation("AlertaSOSAtendidaPor")

  @@index([estadoCuenta])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catálogo configurable de tipos de incidente
// ---------------------------------------------------------------------------

model IncidentType {
  id     String  @id @default(cuid())
  nombre String  @unique
  slug   String  @unique
  activo Boolean @default(true)
  orden  Int     @default(0)

  incidents Incident[]

  @@map("incident_types")
}

// ---------------------------------------------------------------------------
// Enumeraciones compartidas
// ---------------------------------------------------------------------------

enum NivelPrioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoIncidente {
  REPORTADO
  EN_ATENCION
  EN_PROCESO
  RESUELTO
  CERRADO
  DESCARTADO
}

enum TipoDocumento {
  CC
  TI
  CE
  PASAPORTE
  RC
  NUIP
  SIN_DOCUMENTO
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
  NO_INFORMA
}

enum EstadoPersona {
  DESAPARECIDA
  BUSQUEDA
  LOCALIZADA
  ILESA
  HERIDA
  ATRAPADA
  TRASLADADA
  FALLECIDA
  ATENDIDA
}

enum TipoTraslado {
  AMBULANCIA
  VEHICULO_PARTICULAR
  HELICOPTERO
  A_PIE
  OTRO
}

enum EstadoTraslado {
  SOLICITADO
  EN_RUTA
  TRASLADADO
  ATENDIDO_EN_CENTRO
  CANCELADO
}

enum TipoAyuda {
  ALIMENTOS
  AGUA
  REFUGIO_ALOJAMIENTO
  MEDICAMENTOS
  ATENCION_MEDICA
  ROPA_ABRIGO
  RESCATE
  ELEMENTOS_ASEO
  OTRO
}

enum EstadoAyuda {
  SOLICITADA
  EN_PROCESO
  ENTREGADA
  CANCELADA
}

enum AccionAuditoria {
  CREAR
  ACTUALIZAR
  ELIMINAR
  LOGIN
  EXPORTAR
  MFA_ACTIVADA
  MFA_DESACTIVADA
  VER
  APROBAR
  RECHAZAR
}

enum EstadoPuntoAcopio {
  ACTIVO
  PAUSADO
  CERRADO
}

enum EstadoDonacion {
  OFRECIDA
  CONFIRMADA
  RECIBIDA
  CANCELADA
}

enum TipoReporteMascota {
  PERDIDA
  ENCONTRADA
}

enum EspecieMascota {
  PERRO
  GATO
  AVE
  OTRO
}

enum EstadoMascota {
  ACTIVO
  REUNIDO
  CERRADO
}

// ---------------------------------------------------------------------------
// Incidentes / emergencias
// ---------------------------------------------------------------------------

model Incident {
  id     String @id @default(cuid())
  codigo String @unique

  incidentTypeId String
  incidentType   IncidentType @relation(fields: [incidentTypeId], references: [id])
  subtipo        String?
  descripcion    String

  direccion          String
  municipio          String
  departamento       String
  latitud            Float
  longitud           Float
  precisionUbicacion Float?

  nivelPrioridad NivelPrioridad  @default(MEDIA)
  estado         EstadoIncidente @default(REPORTADO)

  fechaEvento  DateTime @default(now())
  fechaReporte DateTime @default(now())

  reporteroNombre   String?
  reporteroTelefono String?
  esAnonimo         Boolean @default(false)

  creadoPorId      String?
  creadoPor        User?   @relation("IncidentCreatedBy", fields: [creadoPorId], references: [id])
  actualizadoPorId String?
  actualizadoPor   User?   @relation("IncidentUpdatedBy", fields: [actualizadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personas  Person[]
  traslados Transfer[]
  ayudas    AidRequest[]
  adjuntos  Attachment[]

  @@index([estado])
  @@index([nivelPrioridad])
  @@index([municipio])
  @@index([incidentTypeId])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Personas afectadas
// ---------------------------------------------------------------------------

model Person {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  nombreCompleto  String
  tipoDocumento   TipoDocumento @default(SIN_DOCUMENTO)
  numeroDocumento String?
  fechaNacimiento DateTime?
  edad            Int?
  sexo            Sexo          @default(NO_INFORMA)
  telefono        String?

  estadoPersona       EstadoPersona @default(DESAPARECIDA)
  condicionSalud      String?
  descripcionFisica   String?
  direccionResidencia String?

  contactoNombre     String?
  contactoTelefono   String?
  contactoParentesco String?

  observaciones String?

  creadoPorId String?
  creadoPor   User?   @relation("PersonCreatedBy", fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  traslados Transfer[]
  adjuntos  Attachment[]

  @@index([incidentId])
  @@index([estadoPersona])
  @@index([numeroDocumento])
  @@map("persons")
}

// ---------------------------------------------------------------------------
// Traslados a centros médicos
// ---------------------------------------------------------------------------

model Transfer {
  id String @id @default(cuid())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  centroMedico   String
  tipoTraslado   TipoTraslado   @default(AMBULANCIA)
  motivo         String
  estadoTraslado EstadoTraslado @default(SOLICITADO)

  fechaTraslado DateTime @default(now())
  vehiculoPlaca String?
  responsable   String?
  observaciones String?

  creadoPorId String?
  creadoPor   User?   @relation("TransferCreatedBy", fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
  @@index([incidentId])
  @@index([estadoTraslado])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Solicitudes de ayuda humanitaria
// ---------------------------------------------------------------------------

model AidRequest {
  id     String @id @default(cuid())
  codigo String @unique

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  nombreSolicitante   String
  telefonoSolicitante String
  tipoAyuda           TipoAyuda @default(OTRO)
  descripcion         String
  cantidadPersonas    Int       @default(1)

  direccion    String
  municipio    String
  departamento String
  latitud      Float?
  longitud     Float?

  prioridad NivelPrioridad @default(MEDIA)
  estado    EstadoAyuda    @default(SOLICITADA)

  creadoPorId      String?
  creadoPor        User?   @relation("AidRequestCreatedBy", fields: [creadoPorId], references: [id])
  actualizadoPorId String?
  actualizadoPor   User?   @relation("AidRequestUpdatedBy", fields: [actualizadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([tipoAyuda])
  @@index([municipio])
  @@map("aid_requests")
}

// ---------------------------------------------------------------------------
// Adjuntos (fotos de incidentes)
// ---------------------------------------------------------------------------

model Attachment {
  id            String   @id @default(cuid())
  incidentId    String
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  personId      String?
  person        Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  url           String
  nombreArchivo String?
  tipoMime      String?
  createdAt     DateTime @default(now())

  @@index([incidentId])
  @@index([personId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Puntos de acopio de donaciones
// ---------------------------------------------------------------------------

model DonationPoint {
  id     String @id @default(cuid())
  codigo String @unique

  nombre         String
  descripcion    String?
  tiposAceptados TipoAyuda[]

  direccion    String
  municipio    String
  departamento String
  latitud      Float
  longitud     Float

  responsable      String?
  telefonoContacto String
  horario          String?

  estado EstadoPuntoAcopio @default(ACTIVO)

  creadoPorId String?
  creadoPor   User?   @relation("DonationPointCreatedBy", fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donaciones  Donation[]
  envios      Envio[]
  inventario  InventarioItem[]
  solicitudes SolicitudInsumo[]

  @@index([estado])
  @@index([municipio])
  @@map("donation_points")
}

// ---------------------------------------------------------------------------
// Donaciones ofrecidas
// ---------------------------------------------------------------------------

model Donation {
  id     String @id @default(cuid())
  codigo String @unique

  donationPointId String?
  donationPoint   DonationPoint? @relation(fields: [donationPointId], references: [id])

  nombreDonante   String
  telefonoDonante String
  tipoAyuda       TipoAyuda @default(OTRO)
  descripcion     String
  insumo          String?
  cantidad        Int?
  unidad          String?

  direccion    String?
  municipio    String
  departamento String
  latitud      Float?
  longitud     Float?

  estado EstadoDonacion @default(OFRECIDA)

  creadoPorId      String?
  creadoPor        User?   @relation("DonationCreatedBy", fields: [creadoPorId], references: [id])
  actualizadoPorId String?
  actualizadoPor   User?   @relation("DonationUpdatedBy", fields: [actualizadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([tipoAyuda])
  @@index([municipio])
  @@map("donations")
}

// ---------------------------------------------------------------------------
// Envíos de insumos desde un punto de acopio hacia un destino
// ---------------------------------------------------------------------------

enum EstadoEnvio {
  PREPARADO
  EN_TRANSITO
  ENTREGADO
}

model Envio {
  id     String @id @default(cuid())
  codigo String @unique

  donationPointId String
  donationPoint   DonationPoint @relation(fields: [donationPointId], references: [id])

  destinatarioNombre   String
  destinatarioTelefono String?

  destinoLugar        String
  destinoMunicipio    String?
  destinoDepartamento String?

  responsable         String
  responsableTelefono String?

  vehiculo          String?
  vehiculoPlaca     String?
  conductorNombre   String?
  conductorTelefono String?

  notas String?

  estado EstadoEnvio @default(PREPARADO)

  items EnvioItem[]

  solicitudInsumoId String?         @unique
  solicitudInsumo   SolicitudInsumo? @relation(fields: [solicitudInsumoId], references: [id])

  creadoPorId String?
  creadoPor   User?   @relation("EnvioCreatedBy", fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donationPointId])
  @@index([estado])
  @@map("envios")
}

model EnvioItem {
  id String @id @default(cuid())

  envioId String
  envio   Envio  @relation(fields: [envioId], references: [id], onDelete: Cascade)

  insumo   String
  cantidad Int
  unidad   String?

  @@index([envioId])
  @@map("envio_items")
}

// ---------------------------------------------------------------------------
// Inventario por punto de acopio (existencias calculadas: sube al recibir
// donaciones, baja al despachar envíos) y solicitudes de apoyo entre puntos.
// ---------------------------------------------------------------------------

model InventarioItem {
  id String @id @default(cuid())

  donationPointId String
  donationPoint   DonationPoint @relation(fields: [donationPointId], references: [id])

  insumo   String
  cantidad Int     @default(0)
  unidad   String?

  updatedAt DateTime @updatedAt

  @@unique([donationPointId, insumo])
  @@index([donationPointId])
  @@map("inventario_items")
}

enum EstadoSolicitudInsumo {
  ABIERTA
  RESUELTA
  CANCELADA
}

model SolicitudInsumo {
  id     String @id @default(cuid())
  codigo String @unique

  donationPointId String
  donationPoint   DonationPoint @relation(fields: [donationPointId], references: [id])

  insumo   String
  cantidad Int
  unidad   String?
  notas    String?

  estado EstadoSolicitudInsumo @default(ABIERTA)

  envio Envio?

  creadoPorId String?
  creadoPor   User?   @relation("SolicitudInsumoCreatedBy", fields: [creadoPorId], references: [id])

  resueltaEn DateTime?

  createdAt DateTime @default(now())

  @@index([donationPointId])
  @@index([estado])
  @@map("solicitudes_insumo")
}

// ---------------------------------------------------------------------------
// Mascotas perdidas / encontradas
// ---------------------------------------------------------------------------

model Pet {
  id     String             @id @default(cuid())
  codigo String             @unique
  tipo   TipoReporteMascota

  especie     EspecieMascota @default(OTRO)
  nombre      String?
  raza        String?
  descripcion String

  fecha DateTime @default(now())

  direccion    String
  municipio    String
  departamento String
  latitud      Float
  longitud     Float

  contactoNombre   String
  contactoTelefono String

  fotoUrl String?

  estado EstadoMascota @default(ACTIVO)

  creadoPorId      String?
  creadoPor        User?   @relation("PetCreatedBy", fields: [creadoPorId], references: [id])
  actualizadoPorId String?
  actualizadoPor   User?   @relation("PetUpdatedBy", fields: [actualizadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([estado])
  @@index([municipio])
  @@map("pets")
}

// ---------------------------------------------------------------------------
// Bitácora de campo: registros internos entre los usuarios que atienden la
// emergencia (rescatistas, voluntarios, coordinadores, centros de acopio,
// entidades) — distinto de los reportes que hacen las personas afectadas.
// No es información pública.
// ---------------------------------------------------------------------------

enum TipoRegistroBitacora {
  ACTUALIZACION
  NECESIDAD
}

enum EstadoNecesidadCampo {
  PENDIENTE
  ATENDIDA
}

model RegistroBitacora {
  id          String                @id @default(cuid())
  tipo        TipoRegistroBitacora
  descripcion String

  direccion    String?
  municipio    String?
  departamento String?
  latitud      Float?
  longitud     Float?

  fotos String[] @default([])

  contactoLugarNombre   String?
  contactoLugarTelefono String?

  estado EstadoNecesidadCampo @default(PENDIENTE)

  autorId String
  autor   User   @relation("RegistroBitacoraAutor", fields: [autorId], references: [id])

  atendidaPorId String?
  atendidaPor   User?     @relation("RegistroBitacoraAtendidaPor", fields: [atendidaPorId], references: [id])
  atendidaEn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([autorId])
  @@index([tipo])
  @@index([estado])
  @@index([createdAt])
  @@map("registros_bitacora")
}

/**
 * Permite a un Administrador o Coordinador marcar qué voluntarios/rescatistas
 * prefiere seguir de cerca, para filtrar la lista de usuarios y el mapa del
 * equipo a "mi equipo" en vez de ver a todo el mundo. También registra las
 * solicitudes que un voluntario envía para unirse al equipo de un
 * coordinador específico (estado PENDIENTE hasta que el coordinador
 * responde). Cuando el coordinador agrega directamente a alguien con la ⭐,
 * la fila nace en ACEPTADO.
 */
enum EstadoSeguimientoEquipo {
  ACEPTADO
  PENDIENTE
  RECHAZADO
}

model SeguimientoEquipo {
  id String @id @default(cuid())

  coordinadorId String
  coordinador   User   @relation("SeguimientoCoordinador", fields: [coordinadorId], references: [id])

  voluntarioId String
  voluntario   User   @relation("SeguimientoVoluntario", fields: [voluntarioId], references: [id])

  estado EstadoSeguimientoEquipo @default(ACEPTADO)

  createdAt DateTime @default(now())

  @@unique([coordinadorId, voluntarioId])
  @@index([coordinadorId])
  @@index([voluntarioId])
  @@index([estado])
  @@map("seguimientos_equipo")
}

// ---------------------------------------------------------------------------
// Alertas SOS: botón de pánico para los usuarios del panel en campo. Notifica
// de inmediato a Administración y Coordinación (dentro de la plataforma y por
// correo) cuando alguien necesita auxilio para sí mismo o por la labor que
// está realizando.
// ---------------------------------------------------------------------------

enum TipoAlertaSOS {
  PERSONAL
  LABOR
}

enum EstadoAlertaSOS {
  ACTIVA
  ATENDIDA
}

model AlertaSOS {
  id   String        @id @default(cuid())
  tipo TipoAlertaSOS
  nota String?

  latitud  Float?
  longitud Float?

  estado EstadoAlertaSOS @default(ACTIVA)

  autorId String
  autor   User   @relation("AlertaSOSAutor", fields: [autorId], references: [id])

  atendidaPorId String?
  atendidaPor   User?     @relation("AlertaSOSAtendidaPor", fields: [atendidaPorId], references: [id])
  atendidaEn    DateTime?

  correoEnviado Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([autorId])
  @@index([estado])
  @@index([createdAt])
  @@map("alertas_sos")
}

// ---------------------------------------------------------------------------
// Llaves de API para integración externa (p. ej. la UNGRD consumiendo datos
// en vivo mediante /api/external/v1). Nunca se guarda la llave en texto
// plano, solo su hash; el prefijo permite ubicarla sin poder reconstruirla.
// ---------------------------------------------------------------------------

model ApiKey {
  id          String    @id @default(cuid())
  nombre      String
  prefijo     String    @unique
  llaveHash   String
  activa      Boolean   @default(true)
  creadoPorId String?
  creadoPor   User?     @relation("ApiKeyCreatedBy", fields: [creadoPorId], references: [id])
  ultimoUsoEn DateTime?
  expiraEn    DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Bitácora de auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id            String          @id @default(cuid())
  entidad       String
  entidadId     String
  accion        AccionAuditoria
  usuarioId     String?
  usuario       User?           @relation(fields: [usuarioId], references: [id])
  usuarioNombre String?
  cambios       Json?
  ip            String?
  createdAt     DateTime        @default(now())

  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Secuencia de códigos por año (EMG-2026-000001)
// ---------------------------------------------------------------------------

model SequenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("sequence_counters")
}
