# Base de datos PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Secreto de NextAuth/Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplaza-con-un-secreto-aleatorio-largo"

# URL pública del sitio (usada por NextAuth para construir enlaces)
NEXTAUTH_URL="http://localhost:3000"

# Almacenamiento de archivos — Vercel Blob (Storage > Blob en el dashboard de Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Credenciales del usuario administrador creado por el script de seed
SEED_ADMIN_EMAIL="admin@emergencias.local"
SEED_ADMIN_PASSWORD="cambia-esta-contrasena"

# Integración futura con Microsoft Graph (Excel/OneDrive) — opcional
# MICROSOFT_GRAPH_CLIENT_ID=""
# MICROSOFT_GRAPH_CLIENT_SECRET=""
# MICROSOFT_GRAPH_TENANT_ID=""

# Envío de correo para las alertas SOS (resend.com — plan gratuito hasta 3000
# correos/mes). Sin esta llave, las alertas SOS siguen funcionando dentro de
# la plataforma, pero no se envía el correo a Administración/Coordinación.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Emergencias <alertas@tudominio.org>"
